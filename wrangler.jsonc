{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mirai-board-audit-governance-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "preview",
    "APP_NAME": "mirai-board-audit-governance"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirai-board-audit-governance-db",
      "database_id": "d39665c7-db16-4281-9e6d-1a821dd0c8c6",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
