{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mbag-webui",
  "main": "./index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "../webui-dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    "run_worker_first": ["/"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
